<Window x:Class="SteamTransfer.OfferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incoming game" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <StackPanel>
        <Grid Height="160">
            <Border x:Name="HeroFallback"/>
            <Border x:Name="HeroImage"/>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.4"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <StackPanel Margin="24,16,24,22">
            <TextBlock x:Name="Kicker" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock x:Name="GameTitle" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,2"/>
            <TextBlock x:Name="Sub" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

            <Border x:Name="ExistingNote" Margin="0,14,0,0" Padding="12,9" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <DockPanel>
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE946;" Margin="0,1,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock TextWrapping="Wrap" Text="Already on this PC — only missing or changed files will be copied."/>
                </DockPanel>
            </Border>

            <TextBlock Text="Install to" FontWeight="SemiBold" Margin="0,16,0,6"/>
            <ListBox x:Name="Libraries" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4">
                            <TextBlock DockPanel.Dock="Left" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEDA2;" FontSize="18"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <CheckBox x:Name="CloseSteam" Margin="0,12,0,0" IsChecked="True"
                      Content="Close Steam while copying and reopen it after (recommended)"/>

            <Border x:Name="ErrorNote" Margin="0,12,0,0" Padding="12,9" CornerRadius="6" Visibility="Collapsed"
                    Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                <DockPanel>
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xE783;" Margin="0,1,10,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="NoButton" MinWidth="110" Margin="0,0,8,0" IsCancel="True" Click="No_Click"/>
                <Button x:Name="YesButton" MinWidth="110" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Yes_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
