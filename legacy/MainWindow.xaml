<Window x:Class="SteamTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam Game Transfer" Width="1320" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/app.ico">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="SemiBold" Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Lists of choices inside the side panel: no own scrolling, full-width rows -->
        <Style x:Key="ChoiceList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- status strip -->
            <RowDefinition Height="Auto"/>   <!-- install info bar -->
            <RowDefinition Height="*"/>      <!-- main -->
            <RowDefinition Height="Auto"/>   <!-- transfer -->
            <RowDefinition Height="Auto"/>   <!-- activity log -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ===== status strip ===== -->
        <DockPanel Margin="20,14,20,6">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE977;" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="MachineText" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
            <WrapPanel x:Name="Chips" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- ===== install info bar ===== -->
        <Border x:Name="InstallBar" Grid.Row="1" Margin="20,6,20,4" CornerRadius="8" Padding="14,10" BorderThickness="1"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed">
            <DockPanel>
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="16" Margin="0,0,12,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Install" Style="{DynamicResource AccentButtonStyle}" MinWidth="90" Click="Install_Click"/>
                    <Button Content="Not now" Margin="8,0,0,0" Click="HideInstall_Click"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold">Install Game Transfer on this PC?</Run>
                    <Run>Adds Start menu and desktop shortcuts and sets up the firewall so other PCs can connect.</Run>
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- ===== main ===== -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- games -->
            <DockPanel Margin="20,4,8,12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,12,12">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="9,7" ToolTip="Refresh games" Click="Refresh_Click">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"/>
                    </Button>
                    <Grid DockPanel.Dock="Right" Width="260">
                        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="SearchHint" Text="Search games" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Your games" FontSize="20" FontWeight="SemiBold"/>
                        <Run x:Name="CountRun" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </TextBlock>
                </DockPanel>

                <Grid>
                    <ListBox x:Name="GamesList" SelectionChanged="Games_SelectionChanged" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="152" Margin="2,4,2,6">
                                    <Grid Height="228">
                                        <Border CornerRadius="8" Background="{Binding Placeholder}">
                                            <TextBlock Text="{Binding Initials}" FontSize="34" FontWeight="Bold" Foreground="#E6FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding ArtImage}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,1" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding UpdateBadge}">
                                            <TextBlock Text="UPDATE" FontSize="10" FontWeight="Bold" Foreground="Black"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,8,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" Margin="2,1,2,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="GamesEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7FC;" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock x:Name="GamesEmptyTitle" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock x:Name="GamesEmptyText" Style="{StaticResource Caption}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- side panel -->
            <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
                <DockPanel>
                    <!-- action -->
                    <Border DockPanel.Dock="Bottom" Padding="18,12,18,18" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10" Text="Pick a game to send."/>
                            <Button x:Name="GoButton" Style="{DynamicResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10" FontSize="15"
                                    IsEnabled="False" Click="Go_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="GoGlyph" Style="{StaticResource Glyph}" Text="&#xE724;" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="GoText" Text="Send"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <ScrollViewer x:Name="SideScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18,18,18,8">
                            <!-- selected game -->
                            <Grid Height="150">
                                <Border x:Name="HeroFallback" CornerRadius="8" Style="{StaticResource Card}">
                                    <TextBlock x:Name="HeroHint" Text="Pick a game on the left" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                                <Border x:Name="HeroImage" CornerRadius="8"/>
                                <Border x:Name="HeroShade" CornerRadius="8" Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.25"/>
                                            <GradientStop Color="#E0000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="14,0,14,12">
                                        <TextBlock x:Name="HeroTitle" FontSize="18" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="HeroSub" FontSize="12" Foreground="#D0FFFFFF" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- PCs -->
                            <TextBlock Text="Send to a PC" Style="{StaticResource SectionHeader}" Margin="0,20,0,8"/>
                            <ListBox x:Name="PeersList" Style="{StaticResource ChoiceList}" SelectionChanged="Target_SelectionChanged" PreviewMouseWheel="PassWheel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="17" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding TagVisibility}">
                                                <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="PeersEmpty" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Looking for other PCs…" FontWeight="SemiBold"/>
                                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,10"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                               Text="Open Game Transfer on the other PC, then connect them with any of these:"/>
                                    <DockPanel x:Name="TipUsb4" Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="16" Width="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12"><Run FontWeight="SemiBold">USB4 / Thunderbolt cable</Run> — fastest, up to 40 Gbps. Use the ⚡ ports on both PCs.</TextBlock>
                                    </DockPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE839;" FontSize="16" Width="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12"><Run FontWeight="SemiBold">Ethernet cable</Run> — PC to PC or through your router. No setup needed.</TextBlock>
                                    </DockPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" FontSize="16" Width="28" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12"><Run FontWeight="SemiBold">Same Wi-Fi</Run> — works, but much slower.</TextBlock>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" Text="A direct cable can take up to a minute to connect."/>
                                </StackPanel>
                            </Border>

                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0" Click="AddPeer_Click"/>
                                <Grid>
                                    <TextBox x:Name="IpBox" KeyDown="Ip_KeyDown" TextChanged="Ip_Changed" VerticalContentAlignment="Center"/>
                                    <TextBlock x:Name="IpHint" Text="Not listed? Type its IP address" IsHitTestVisible="False" Margin="12,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Grid>
                            </DockPanel>

                            <!-- drives -->
                            <DockPanel Margin="0,22,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Other folder…" Click="BrowseExport_Click" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy to a drive" Style="{StaticResource SectionHeader}"/>
                            </DockPanel>
                            <ListBox x:Name="DrivesList" Style="{StaticResource ChoiceList}" SelectionChanged="Target_SelectionChanged" PreviewMouseWheel="PassWheel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TooSmall}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" Margin="0,0,12,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="17" HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                                                <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="3" MinHeight="3" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="DrivesEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Plug in a USB drive or external SSD to copy a game onto it."/>

                            <!-- packages -->
                            <DockPanel Margin="0,22,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Browse…" Click="BrowseImport_Click" VerticalAlignment="Center"/>
                                <TextBlock Text="Install from a drive" Style="{StaticResource SectionHeader}"/>
                            </DockPanel>
                            <ItemsControl x:Name="PackagesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <Grid DockPanel.Dock="Left" Width="40" Height="60" Margin="0,0,12,0">
                                                    <Border CornerRadius="4" Background="{Binding Placeholder}">
                                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="4">
                                                        <Border.Background><ImageBrush ImageSource="{Binding ArtImage}" Stretch="UniformToFill"/></Border.Background>
                                                    </Border>
                                                </Grid>
                                                <Button DockPanel.Dock="Right" Content="Install" VerticalAlignment="Center" Tag="{Binding}" Click="ImportPackage_Click"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="PackagesEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                                       Text="Games copied to a drive with this app show up here when you plug the drive in."/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===== transfer ===== -->
        <Border x:Name="TransferPanel" Grid.Row="3" Style="{StaticResource Card}" Margin="20,10,20,6" Padding="16,12" Visibility="Collapsed">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="TPercent" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,16,0" MinWidth="56" TextAlignment="Right"/>
                        <Button x:Name="TPause" Click="Pause_Click" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE769;" Margin="0,0,8,0"/><TextBlock Text="Pause"/></StackPanel>
                        </Button>
                        <Button x:Name="TResume" Click="Resume_Click" Margin="0,0,8,0" Style="{DynamicResource AccentButtonStyle}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Margin="0,0,8,0"/><TextBlock Text="Resume"/></StackPanel>
                        </Button>
                        <Button x:Name="TCancel" Click="Cancel_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" Margin="0,0,8,0"/><TextBlock Text="Cancel"/></StackPanel>
                        </Button>
                        <Button x:Name="TClose" Content="Close" Click="CloseTransfer_Click" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock x:Name="TAlertGlyph" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="TStats" Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="TBar" Margin="0,10,0,6" Maximum="1000"/>
                <TextBlock x:Name="TFile" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ===== activity log ===== -->
        <Border x:Name="LogPanel" Grid.Row="4" Style="{StaticResource Card}" Margin="20,4,20,4" Padding="0" Height="190" Visibility="Collapsed">
            <TextBox x:Name="LogBox" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="10"/>
        </Border>

        <!-- ===== status bar ===== -->
        <DockPanel Grid.Row="5" Margin="20,2,20,8">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            <ToggleButton x:Name="LogToggle" DockPanel.Dock="Left" Padding="8,3" Margin="0,0,10,0" Checked="LogToggle_Changed" Unchecked="LogToggle_Changed">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" FontSize="12" Margin="0,0,6,0"/><TextBlock Text="Activity" FontSize="12"/></StackPanel>
            </ToggleButton>
            <TextBlock x:Name="LastLog" Style="{StaticResource Caption}" VerticalAlignment="Center" Text="Ready."/>
        </DockPanel>

        <!-- ===== notifications ===== -->
        <StackPanel x:Name="Toasts" Grid.RowSpan="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,56" Width="380"/>
    </Grid>
</Window>
